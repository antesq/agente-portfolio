# ==========================================================================
# Copie este arquivo para ".env" e preencha os valores.
# NUNCA versione o arquivo .env com chaves reais (ele já está no .gitignore).
# ==========================================================================

# --- Claude API (Anthropic) -----------------------------------------------
# Crie sua chave em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# Modelo usado pelo agente (opcional; padrão = claude-opus-5)
CLAUDE_MODEL=claude-opus-5

# --- Smartsheet -----------------------------------------------------------
# Gere o token em: Smartsheet > Account > Personal Settings > API Access
# IMPORTANTE: o agente só LÊ o Smartsheet. Use um token da área de HOMOLOGAÇÃO,
# nunca de produção.
SMARTSHEET_ACCESS_TOKEN=

# --- Microsoft 365 / Outlook (Microsoft Graph) ----------------------------
# Registre um app em https://portal.azure.com > App registrations (single tenant).
# Permissão delegada necessária: Mail.Read.
# Adicione a plataforma "Mobile and desktop applications" com redirect
#   http://localhost   e habilite "Allow public client flows" = Yes.
MS_CLIENT_ID=
MS_TENANT_ID=
# Modo de login: "interactive" (navegador, recomendado) ou "device" (código).
MS_AUTH_MODE=interactive
# Deixe o cache de token neste caminho para não logar toda vez:
MS_TOKEN_CACHE=.ms_token_cache.bin

# --- WhatsApp Desktop -----------------------------------------------------
# Título (ou parte do título) da janela do WhatsApp Desktop instalado.
# Normalmente "WhatsApp". Ajuste se seu app aparecer com outro nome.
WHATSAPP_WINDOW_TITLE=WhatsApp

# --- Saída ----------------------------------------------------------------
# Pasta onde as planilhas de portfólio serão salvas.
OUTPUT_DIR=./saida
